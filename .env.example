# ============================================================================
#  PriceWatch configuration. Copy to .env and fill in:   cp .env.example .env
#  How to get every value: docs/DATA.md  (and SETUP_GUIDE.txt)
# ============================================================================

# --- Core -------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:8000
# Public URL of the dashboard (used in Telegram buttons and e-mails)
SITE_URL=http://localhost:8000
TIME_ZONE=Asia/Tashkent
# Hide the admin under a less obvious path in production, e.g. control-7f3a/
ADMIN_URL=admin/

# --- Database & Redis (values below match docker-compose.yml) ---------------
POSTGRES_DB=pricewatch
POSTGRES_USER=pricewatch
POSTGRES_PASSWORD=pricewatch
DATABASE_URL=postgres://pricewatch:pricewatch@db:5432/pricewatch
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Demo ------------------------------------------------------------------
# Password for demo@pricewatch.local and admin@pricewatch.local created by `seed_demo`
DEMO_USER_PASSWORD=demo12345
# How often (seconds) prices change in the bundled demo shop
DEMO_SHOP_CHANGE_INTERVAL=120

# --- Telegram (optional; without it alerts go to the log) ------------------
# @BotFather -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=
# Bot username without @ (for the "Open bot" link in the dashboard)
TELEGRAM_BOT_USERNAME=
# Your personal chat id (get it from @userinfobot) — receives SCRAPER_DEGRADED alerts
ADMIN_TELEGRAM_CHAT_ID=
# polling (default) or webhook
BOT_MODE=polling
# Only for BOT_MODE=webhook: public HTTPS URL, e.g. https://pricewatch.uz/tg/webhook
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# --- Scraping ----------------------------------------------------------------
# Comma-separated proxies, e.g. http://user:pass@1.2.3.4:8000,http://user:pass@5.6.7.8:8000
PROXY_URLS=
SCRAPER_TIMEOUT=20
SCRAPER_MAX_RETRIES=3
SCRAPER_RESPECT_ROBOTS=True

# --- Monitoring (optional) ---------------------------------------------------
# sentry.io -> Create project (Django) -> Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=INFO

# --- E-mail (optional; console backend prints e-mails to logs) --------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PriceWatch <noreply@pricewatch.local>

# --- Production only ---------------------------------------------------------
# Domain for HTTPS (Caddy obtains a Let's Encrypt certificate automatically)
DOMAIN=
ACME_EMAIL=
